generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String?
  name         String
  role         String   @default("buyer") // "buyer" | "creator" | "admin"
  googleId     String?  @unique
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  creator       Creator?
  reviews       Review[]
  recentViews   RecentView[]
  notifications Notification[]
}

model Creator {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String   @unique
  bio       String?
  tagline   String?
  specialty String?
  platform  String?
  avatar    String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  category    String
  subCategory String?
  // JSON array stored as string, e.g. '["ebook","notion"]'
  tags        String   @default("[]")
  price       Float
  currency    String   @default("EUR")
  isFree      Boolean  @default(false)
  language    String   @default("fr")
  country     String?
  platform    String
  purchaseUrl String
  coverImage  String?
  // "pending" | "active" | "rejected"
  status      String   @default("pending")
  views       Int      @default(0)
  clicks      Int      @default(0)
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews     Review[]
  recentViews RecentView[]
  dailyStats  DailyStats[]
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5
  comment   String?
  // "pending" | "approved" | "rejected"
  status    String   @default("pending")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model RecentView {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "product_approved" | "product_rejected" | "review_pending" | "creator_verified" | etc.
  title     String
  message   String
  productId String?  // lien optionnel vers le produit
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

model DailyStats {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  date      String   // "2026-07-17"
  views     Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([productId, date])
  @@index([productId])
  @@index([date])
}

model TrackingLog {
  id            String   @id @default(cuid())
  productId     String
  userId        String?
  ipAddress     String?
  userAgent     String?
  type          String   // "view" | "click"
  isBot         Boolean  @default(false)
  isRateLimited Boolean  @default(false)
  isSuspicious  Boolean  @default(false)
  timestamp     DateTime @default(now())

  @@index([productId])
  @@index([userId])
  @@index([ipAddress])
  @@index([timestamp])
  @@index([isBot])
  @@index([isSuspicious])
}
